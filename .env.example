# ─── Silverbed configuration ────────────────────────────────────────────────
# Copy to server/.env (the API scripts run with server/ as their working directory)
# or export the variables yourself. A .env at the repository root is not loaded.

# server
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_DIR=./data
WEB_DIST=../web/dist
ALLOW_ORIGIN=*
MAX_UPLOAD_MB=32

# database ── leave DATABASE_URL empty to use the embedded PGlite database.
# Supabase: use the connection pooler string from Project settings → Database.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# PGLITE_DIR=./data/pglite        # persist the embedded database to disk

# sessions
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=604800

# auth ── local | supabase | both
#   local    = this app verifies its own scrypt passwords + HS256 JWTs (default)
#   supabase = only Supabase access tokens are accepted
#   both     = local accounts AND Supabase access tokens (recommended for self-hosted)
AUTH_MODE=local

# ─── self-hosted Supabase (Docker Compose stack) ────────────────────────────
# Point these at your own instance; the app never needs the Supabase JS SDK.
# https://supabase.com/docs/guides/self-hosting/docker
# SUPABASE_URL=http://127.0.0.1:8000
# SUPABASE_ANON_KEY=<ANON_KEY from your .env>
#
# Token verification — pick ONE (or set both during a migration):
#   1. HS256 shared secret (classic): the JWT_SECRET of your Supabase stack
# SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
#   2. RS256/ES256 via JWKS (newer stacks sign asymmetrically; auto-derived from
#      SUPABASE_URL as <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=
#
# Verify passwords against GoTrue instead of this app's own hashes.
# Requires SUPABASE_URL + SUPABASE_ANON_KEY. When enabled, sign-in is by email
# and registration creates the account in Supabase.
SUPABASE_PASSWORD_LOGIN=false

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# storage ── local | s3
# Vercel deployments must use s3: the function filesystem is read-only.
# Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto,
# S3_PUBLIC_URL = the bucket's public domain (r2.dev or a custom domain).
# The bucket needs CORS allowing PUT + GET from your site's origin.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# mail (optional — without SMTP_HOST messages go to the console and the admin outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Silverbed <no-reply@silverbed.local>"

# misc
GUEST_UPLOAD=false
# per-IP throttling on auth/upload endpoints; disable in automated test runs
RATE_LIMIT=true
SEED_DEMO=true
